{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "planning-decisions",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "DEC-\\d{3}"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "accepted",
              "superseded",
              "rejected"
            ]
          },
          "proposed_on": {
            "type": "string",
            "format": "date"
          },
          "proposed_by": {
            "type": "string",
            "minLength": 1
          },
          "accepted_on": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ]
          },
          "accepted_by": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "acceptance_requirement": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "rationale",
          "status",
          "proposed_on",
          "proposed_by",
          "accepted_on",
          "accepted_by",
          "evidence",
          "acceptance_requirement"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "decisions"
  ],
  "additionalProperties": false
}
