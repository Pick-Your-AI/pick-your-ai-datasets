{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "planning-backlog",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "repository": {
      "type": "string",
      "const": "Pick-Your-AI/pick-your-ai-datasets"
    },
    "program_id": {
      "type": "string",
      "const": "DATA"
    },
    "external_parent": {
      "type": "string",
      "format": "uri"
    },
    "project": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "data_type": {
                "type": "string",
                "const": "SINGLE_SELECT"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "name",
              "data_type",
              "options"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "views": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "layout": {
                "type": "string",
                "enum": [
                  "TABLE_LAYOUT",
                  "BOARD_LAYOUT",
                  "ROADMAP_LAYOUT"
                ]
              },
              "filter": {
                "type": "string"
              },
              "group_by": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sort_by": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "visible_fields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "name",
              "layout",
              "filter",
              "group_by",
              "sort_by",
              "visible_fields"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "title",
        "number",
        "url",
        "description",
        "fields",
        "views"
      ],
      "additionalProperties": false
    },
    "representation": {
      "type": "object",
      "properties": {
        "native_issues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "checklists": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "rule": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "native_issues",
        "checklists",
        "rule"
      ],
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "DATA(-\\d{2}(\\.\\d{2})?)?"
          },
          "record_type": {
            "type": "string",
            "enum": [
              "Program",
              "Epic",
              "Work Package"
            ]
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "DATA(-\\d{2}(\\.\\d{2})?)?"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "workstream": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "type": "string",
            "minLength": 1
          },
          "release_phase": {
            "type": "string",
            "minLength": 1
          },
          "modality": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "artifact_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "deliverables": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "evidence_requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "non_goals": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "blocked_by": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "DATA(-\\d{2}(\\.\\d{2})?)?"
            },
            "uniqueItems": true
          },
          "review_requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "handoffs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "repository": {
                  "type": "string",
                  "pattern": "Pick-Your-AI/[a-z0-9.-]+"
                },
                "artifact": {
                  "type": "string",
                  "minLength": 1
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "inbound",
                    "outbound"
                  ]
                }
              },
              "required": [
                "repository",
                "artifact",
                "direction"
              ],
              "additionalProperties": false
            }
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "DATA-\\d{2}\\.\\d{2}\\.T\\d+"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "subtasks": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "DATA-\\d{2}\\.\\d{2}\\.T\\d+\\.S\\d+"
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "id",
                      "title"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "title",
                "subtasks"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "record_type",
          "parent_id",
          "title",
          "summary",
          "workstream",
          "priority",
          "effort",
          "release_phase",
          "modality",
          "category",
          "artifact_paths",
          "deliverables",
          "evidence_requirements",
          "acceptance_criteria",
          "non_goals",
          "blocked_by",
          "review_requirements",
          "handoffs",
          "tasks"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "repository",
    "program_id",
    "external_parent",
    "project",
    "representation",
    "items"
  ],
  "additionalProperties": false
}
